# Sao chép file này thành `.env` và điền giá trị thật. KHÔNG commit `.env`.

# --- Database: TiDB Cloud Starter (tương thích MySQL 8) ---
# Lấy ở TiDB Cloud console -> Connect -> "Connect with: General".
# Giữ nguyên `?ssl=true` (TiDB Cloud bắt buộc TLS). Cổng mặc định là 4000.
DATABASE_URL="mysql://<user>:<password>@<host>:4000/<database>?ssl=true"

# Số kết nối tối đa cho mỗi instance serverless trên Vercel. Mặc định 3 nếu bỏ trống.
DATABASE_CONNECTION_LIMIT="3"

# Đặt "false" khi chạy MySQL local không bật TLS (host localhost tự động bỏ qua SSL).
# DATABASE_SSL="false"

# --- Cron (Vercel Cron) ---
# Chuỗi ngẫu nhiên đủ dài. Vercel tự gửi kèm header `Authorization: Bearer $CRON_SECRET`
# tới các route khai báo trong vercel.json.
CRON_SECRET=""

# --- Test API (k6) ---
API_BASE_URL="http://localhost:3000/api"

# Hai bộ tài khoản cho test script "Tạo khoản chi tiêu"
# (test/transaction/expense/testscript.js). Phải là hai user KHÁC nhau:
# - A: chủ thể test. B: chỉ để lấy account/category không thuộc A.
# Bỏ trống thì script tự đăng ký user ngẫu nhiên.
TEST_A_EMAIL=""
TEST_A_PASSWORD=""
TEST_B_EMAIL=""
TEST_B_PASSWORD=""

# --- Session (tùy chọn, đã có default trong code) ---
# SESSION_COOKIE_NAME="session"
# SESSION_TTL_DAYS="30"
