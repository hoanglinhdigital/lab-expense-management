        <!-- VPC boundary -->
        <mxCell id="vpc-1" value="expense-prod-vpc" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;dashed=1;dashPattern=8 4;strokeColor=#5A30B5;fillColor=none;" vertex="1" parent="1">
